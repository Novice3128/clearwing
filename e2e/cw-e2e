#!/bin/sh
# cw-e2e shim — runs the suite with the repo venv python (3.11), cwd-anchored.
# Never installs anything into the venv; never touches member files (SPEC §2.2).
set -eu
E2E_ROOT="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(dirname "$E2E_ROOT")"
PY="$REPO_ROOT/.venv/bin/python"
[ -x "$PY" ] || { echo "cw-e2e: repo venv python not found at $PY" >&2; exit 1; }
exec "$PY" "$E2E_ROOT/runner.py" "$@"
